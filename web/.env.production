# Valores públicos de produção. Não adicionar senhas ou tokens neste arquivo.
# Variáveis definidas na hospedagem têm prioridade sobre este valor.
NEXT_PUBLIC_SITE_URL=https://beautyconta.vercel.app

# Endereço da API em produção. A página de agendamento chega à cliente por um
# link no WhatsApp e chama este endereço direto do navegador dela — por isso ele
# precisa ser o público, não o localhost do desenvolvimento.
NEXT_PUBLIC_API_URL=https://beautyconta.onrender.com
