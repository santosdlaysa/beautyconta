# Configuração da API do BeautyConta.
#
# Copie para `.env` e ajuste. O arquivo `.env` é ignorado pelo Git — nenhuma
# senha real entra aqui.
#
# Em produção não existe arquivo: as mesmas variáveis são definidas no painel da
# hospedagem. As marcadas como OBRIGATÓRIA EM PRODUÇÃO não têm padrão seguro, e
# esquecer uma delas não dá erro visível — só comportamento errado.

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------

# Porta do servidor. A hospedagem costuma definir isto sozinha.
PORT=3333

# `production` liga o comportamento de produção: o registro fica só em erro e o
# cliente do banco deixa de ser reaproveitado entre recargas.
NODE_ENV=development

# Origens autorizadas a chamar a API, separadas por vírgula.
#
# OBRIGATÓRIA EM PRODUÇÃO. Sem ela, o padrão é uma lista de `localhost` — que em
# produção não autoriza ninguém e derruba a web e o aplicativo em silêncio, com
# erro de CORS no navegador e nada no registro do servidor.
#
# Em desenvolvimento: 3000 é a web em Next.js, 3001 é a porta que ela assume
# quando a 3000 já está ocupada, e 8081 é o Expo na web (que também muda de
# porta sozinho). Faltar uma dessas dá erro de CORS no navegador e silêncio no
# registro do servidor.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Endereço público do site, usado para montar o link da agenda que a
# profissional compartilha: <site>/agendar/studio-marina.
#
# O servidor entrega o link pronto para que aplicativo e web digam exatamente o
# mesmo endereço, e trocar o domínio seja mexer num lugar só.
PUBLIC_SITE_URL=https://beautyconta.com.br

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

# PostgreSQL. Lida diretamente pelo Prisma, e não pelo código da aplicação.
#
# OBRIGATÓRIA SEMPRE. Sem ela o processo nem sobe.
#
# No Render existem dois endereços para o mesmo banco:
#
# - **interno** (`...-a`, sem domínio público): use este quando a API roda no
#   próprio Render. É mais rápido e o tráfego não sai para a internet;
# - **externo** (`...-a.oregon-postgres.render.com`): use este para acessar de
#   fora, como da sua máquina. Exige `?sslmode=require` no final.
#
# O banco gratuito do Render também não concede a permissão que o
# `prisma migrate dev` usa para conferir desvio de esquema; contra ele, escreva
# o `migration.sql` à mão e aplique com `npm run db:deploy`.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ---------------------------------------------------------------------------
# Cobrança
# ---------------------------------------------------------------------------

# Segredos dos webhooks. **Sem eles, o webhook do provedor correspondente
# recusa tudo.**
#
# A falha é fechada de propósito: um webhook sem verificação de assinatura
# aceita qualquer pessoa que descubra a URL, e quem esquecesse a variável não
# veria erro nenhum — só uma tabela de eventos de cobrança que qualquer um pode
# escrever. Melhor recusar em voz alta do que aceitar em silêncio.
#
# O do Mercado Pago sai do painel de webhooks; o do RevenueCat é o valor que
# você combina no cabeçalho `Authorization` da configuração de webhook deles.
MERCADO_PAGO_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Credencial de produção do Mercado Pago (`APP_USR-...`, em Suas integrações →
# Credenciais de produção).
#
# **Sem ela o checkout não existe:** a assinatura responde que ainda não está
# disponível, em vez de mandar a assinante para uma página que não cobra nada.
#
# É a mesma credencial para os dois caminhos: cartão, que vira assinatura
# recorrente, e Pix, que é pagamento avulso. O Mercado Pago **não faz cobrança
# recorrente automática por Pix** — quem paga assim compra um período que
# termina, e a tela avisa isso antes.
MERCADO_PAGO_ACCESS_TOKEN=

# Para onde o Mercado Pago devolve a assinante ao concluir o pagamento.
MERCADO_PAGO_RETURN_URL=https://beautyconta.com.br/assinatura

# Endereço público **deste servidor**, para o Mercado Pago avisar do pagamento.
#
# Sem ele o Pix é aprovado e nunca vira acesso: a preferência de pagamento não
# tem para onde notificar, e ninguém fica sabendo que a assinante pagou.
MERCADO_PAGO_WEBHOOK_URL=https://SEU-SERVIDOR/api/billing/webhooks/mercado-pago

# Mapa de identificador de produto para plano, exigido pelo item F-03 do
# backlog. Formato `produto:PLANO:PERIODO`, separado por vírgula.
#
# PLANO é PREMIUM ou MASTER; PERIODO é MONTHLY ou ANNUAL. Linha em formato
# inválido é ignorada com aviso no registro, em vez de derrubar a API inteira —
# mas o produto não mapeado deixa de conceder plano.
REVENUECAT_PRODUCTS=beautyconta_premium_monthly:PREMIUM:MONTHLY,beautyconta_master_annual:MASTER:ANNUAL

# Aceitar compras de ambiente de teste do RevenueCat.
#
# **Nunca `true` em produção.** Compra de sandbox chega pelo mesmo webhook, com
# o mesmo cabeçalho, e é evento verdadeiro: liberar aqui significa conceder o
# plano pago a quem "comprou" com conta de teste da loja, sem pagar nada.
REVENUECAT_ACCEPT_SANDBOX=false

# Preço de cada oferta, em centavos inteiros (ADR-0002).
#
# Formato `PLANO:PERIODO:CENTAVOS`, separado por vírgula. PLANO é PREMIUM ou
# MASTER; PERIODO é MONTHLY ou ANNUAL. O exemplo abaixo vende o Premium por
# R$ 29,90 por mês ou R$ 299,00 por ano.
#
# **Sem esta variável a tela de planos não mostra botão de compra.** É de
# propósito: Apple e Google recusam a submissão quando o valor não aparece
# antes da compra, e é melhor a venda não aparecer do que aparecer sem preço.
#
# Vale só para a venda pela web. Quando a compra é feita dentro do aplicativo
# numa loja, quem manda no preço é a loja — o valor é definido no App Store
# Connect e no Play Console, varia por país e moeda, e a tela precisa mostrar o
# que o SDK devolver.
PLAN_PRICES=PREMIUM:MONTHLY:2990,PREMIUM:ANNUAL:29900

# Documentos que a tela de assinatura precisa linkar. As lojas exigem os dois
# na mesma tela do botão de compra, e link morto é motivo de recusa.
TERMS_URL=https://beautyconta.com.br/termos
PRIVACY_URL=https://beautyconta.com.br/privacidade
SUPPORT_EMAIL=suporte@beautyconta.com.br

# ---------------------------------------------------------------------------
# Avisos administrativos (Telegram)
# ---------------------------------------------------------------------------

# Avisam quem cuida do produto — não a usuária — sobre cadastro novo, evento de
# assinatura e erro 500, além do relatório diário.
#
# OPCIONAIS. Sem as duas primeiras, nada é enviado e o sistema segue igual: é o
# padrão em desenvolvimento e na suíte, que não tocam em rede. O par é tudo ou
# nada — token sem destino não entrega mensagem nenhuma.
#
# Como obter:
#
# 1. no Telegram, fale com o @BotFather e envie /newbot. Ele devolve o token no
#    formato `0000000000:AA...` — este é o TELEGRAM_BOT_TOKEN;
# 2. mande qualquer mensagem para o bot que você acabou de criar (ele não
#    consegue escrever primeiro para quem nunca falou com ele);
# 3. abra `https://api.telegram.org/bot<TOKEN>/getUpdates` e copie o
#    `message.chat.id` da resposta — este é o TELEGRAM_CHAT_ID.
#
# Para receber em grupo, adicione o bot ao grupo e use o `chat.id` de lá, que é
# negativo. Vale a pena: em grupo mais de uma pessoa acompanha, e trocar quem
# recebe não exige mexer no servidor.
#
# O token dá controle total do bot. Ele não entra no Git — este arquivo é só o
# exemplo — e em produção vai no painel da hospedagem.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Erro 500 vira aviso. Ponha `false` para desligar só isso, mantendo os demais.
#
# Existe porque uma falha em laço vira enxurrada de mensagem, e o próprio
# Telegram passa a recusar envio quando isso acontece — deixando você sem nenhum
# aviso justamente durante o incidente.
TELEGRAM_ALERT_ON_ERROR=true

# Horário do relatório diário, em cron, no fuso de Brasília. O padrão é 8h.
#
# Expressão inválida desliga o relatório com aviso no registro, em vez de
# derrubar a API. Só é agendado quando o Telegram está configurado.
TELEGRAM_DAILY_REPORT_CRON=0 8 * * *
