# Porta do servidor da API
PORT=3333

# Origens autorizadas a chamar a API, separadas por vírgula.
# O aplicativo Expo na web pede a porta 8081 (ou a que você abrir).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# PostgreSQL. O SSL é obrigatório na conexão externa do Render.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Cobrança. Sem o segredo, o webhook do provedor correspondente recusa tudo:
# a falha é fechada de propósito, porque webhook sem verificação aceita
# qualquer pessoa que descubra a URL.
MERCADO_PAGO_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Mapa de produto para plano, no formato produto:PLANO:PERIODO, separado por
# vírgula. Exigido pelo item F-03.
REVENUECAT_PRODUCTS=beautyconta_premium_monthly:PREMIUM:MONTHLY,beautyconta_master_annual:MASTER:ANNUAL

# Aceitar compras de ambiente de teste do RevenueCat. Nunca em produção:
# compra de sandbox é evento verdadeiro e concederia plano pago sem pagamento.
REVENUECAT_ACCEPT_SANDBOX=false
