# Endereço da API do BeautyConta.
#
# Só é obrigatório quando o servidor não está na mesma máquina que serve o
# pacote do Expo: sem esta variável, o aplicativo usa o host do Metro na porta
# 3333, o que já resolve o Expo Go em celular físico na mesma rede.
#
# Copie para `.env` e ajuste. O prefixo EXPO_PUBLIC_ é o que faz a variável
# chegar ao código do aplicativo.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3333

# Endereço do site que hospeda a agenda pública.
#
# É o que a profissional compartilha: o link vira `<site>/agendar/<token>`, e
# quem abre é a cliente, no navegador, sem instalar o aplicativo. Não é o mesmo
# endereço da API acima — só coincide por acaso em desenvolvimento.
#
# Sem esta variável vale o domínio de produção, que é o certo para o aplicativo
# publicado. Ajuste aqui para apontar para o site que você está rodando.
EXPO_PUBLIC_SITE_URL=https://beautyconta.com.br
