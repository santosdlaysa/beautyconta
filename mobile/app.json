{
  "expo": {
    "name": "BeautyConta",
    "slug": "beautyconta",
    "description": "Precificação e gestão simples para profissionais de beleza.",
    "scheme": "beautyconta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fffbfd"
    },
    "android": {
      "package": "com.laysadiniz.sweetpricing",
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#fad7f2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 16
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beautyconta.app",
      "infoPlist": {
        "CFBundleDisplayName": "BeautyConta",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "beauty-conta",
    "extra": {
      "eas": {
        "projectId": "ffb8dd18-e8ee-4830-80c3-bc409314cab7"
      }
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
